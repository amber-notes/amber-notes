<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The Mac download (Developer ID, target PaneDirect). Apple doesn't allow the Sign in with
     Apple entitlement in Developer ID profiles, so this build signs in with Apple on the web
     (Supabase OAuth in an ASWebAuthenticationSession) and needs no restricted entitlement. -->
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
