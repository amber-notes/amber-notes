<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The Mac app as installed: team-signed, so it can use Sign in with Apple.
     Ad-hoc development and test builds use Pane-mac.entitlements instead, since a
     restricted entitlement without a provisioning profile stops an app launching. -->
<dict>
	<key>com.apple.developer.applesignin</key>
	<array><string>Default</string></array>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
