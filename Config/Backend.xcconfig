// Which Supabase project the app syncs with. This points at the local dev stack
// (supabase start); the publishable key below is the standard local-only demo key.
// For your own project, create Config/Backend.local.xcconfig (gitignored) with the
// same two settings; it overrides these.
PANE_SUPABASE_URL = http:/$()/127.0.0.1:56421
PANE_SUPABASE_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
// Where shared notes open: the web/ site (`cd web && pnpm dev` serves it on 5210 locally).
PANE_SHARE_URL = http:/$()/localhost:5210
// The MCP server's public address, shown in Connect an AI (https://mcp.ambernotes.app for release
// builds). Empty: the app shows the Supabase function's own address.
PANE_MCP_URL =
// Error reports and usage counts (docs/Technical/app-telemetry.md): the PostHog project key
// (phc_…, the public write-only key the website's pages carry as NEXT_PUBLIC_POSTHOG_KEY) and the
// EU host. Empty here, so a build sends nothing; release builds get the key from
// Config/Backend.local.xcconfig. Debug builds and the Simulator never send, key or not.
PANE_POSTHOG_KEY =
PANE_POSTHOG_HOST = https:/$()/eu.i.posthog.com
#include? "Backend.local.xcconfig"
